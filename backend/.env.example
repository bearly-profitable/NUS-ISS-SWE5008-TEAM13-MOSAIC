# Copy this file to .env and fill in real values.

# ---- OpenRouter (single provider for text + image) ----
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=openai/gpt-5.6-luna
# Only ever called from the Generate panel, by hand -- no pipeline stage
# touches it. Leave it set even if you never generate an image.
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2.5-flare
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ---- Supabase (service role — server-side only, never in frontend/.env) ----
# Project Settings -> API -> service_role key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Campaign defaults ----
CAMPAIGN_BUDGET_CEILING_DEFAULT=150
MAX_REVISION_CYCLES=3

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173

# ---- Resend (real dispatch from the Approval Queue) ----
# https://resend.com/api-keys
# RESEND_FROM must be on a domain verified in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM=MOSAIC <mosaic@yourdomain.com>
RESEND_REPLY_TO=
DEFAULT_RECIPIENT=
