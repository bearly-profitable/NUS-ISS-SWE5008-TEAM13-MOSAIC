{
  "name": "mosaic-intro-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion product intro for the MOSAIC Campaign Console",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render MosaicIntro out/mosaic-intro.mp4",
    "render:nobgm": "remotion render MosaicIntro out/mosaic-intro-nobgm.mp4 --props=props-nobgm.json",
    "still": "remotion still MosaicIntro out/frame.png --frame=1770",
    "capture": "node capture/capture.mjs && python capture/postprocess.py",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.523",
    "@remotion/google-fonts": "4.0.523",
    "@remotion/shapes": "4.0.523",
    "lucide-react": "^0.462.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.523"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "playwright": "^1.56.1",
    "typescript": "^5.6.3"
  }
}
