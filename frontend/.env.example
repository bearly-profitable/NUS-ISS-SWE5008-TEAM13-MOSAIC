# Copy this file to .env.local and fill in real values.
# Vite only exposes vars prefixed VITE_ to the browser — never put the
# Gemini API key here, it belongs in backend/.env only.

# Supabase project (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the Python Orchestrator backend (see ../backend).
# Vite inlines this at BUILD time, so on Railway it must be set on the Console
# service before the build runs — changing it later needs a redeploy, not a
# restart. In production it is the backend service's public domain, e.g.
#   VITE_ORCH_API_BASE=https://mosaic-orchestrator-production.up.railway.app
VITE_ORCH_API_BASE=http://localhost:8000
